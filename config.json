{
  "name": "lumora",
  "dialect": "sqlite",
  "port": 3000,
  "cors": {
    "origin": ["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3001"]
  },
  "auth": {
    "enabled": true,
    "jwtExpiry": "7d",
    "roles": ["guest", "user", "mod", "admin"]
  },
  "storage": {
    "buckets": [
      { "name": "products", "public": true },
      { "name": "avatars", "public": true },
      { "name": "invoices", "public": false }
    ]
  }
}
